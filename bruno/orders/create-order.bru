meta {
  name: Create Order
  type: http
  seq: 1
}
post {
  url: {{base_url}}/orders
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "restaurant_id": "REPLACE_WITH_RESTAURANT_ID",
    "delivery_address": "Block A, GK Campus",
    "notes": "Extra spicy please",
    "items": [
      {
        "menu_item_id": "REPLACE_WITH_MENU_ITEM_ID",
        "quantity": 2
      }
    ]
  }
}
