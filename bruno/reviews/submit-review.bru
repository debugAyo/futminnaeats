meta {
  name: Submit Review
  type: http
  seq: 2
}
post {
  url: {{base_url}}/restaurants/:id/reviews
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
params:path {
  id: REPLACE_WITH_RESTAURANT_ID
}
body:json {
  {
    "rating": 5,
    "comment": "Amazing jollof rice, highly recommend!"
  }
}
